filters:
  and:
    - file.inFolder("areas")
    - file.folder.endsWith("ops/prds")
    - file.ext == "md"
formulas:
  status_label: if(status == "needs_attention", "🟥 Attention", if(status == "review" && review_mode == "human", "🟥 Attention", if(status == "in_progress", "In Progress", if(status == "queue", "Queue", if(status == "done", "Done", "Review")))))
  area: file.path.split("/")[1]
  needs_attention: status == "needs_attention" || (status == "review" && review_mode == "human")
properties:
  project:
    displayName: Project
  formula.area:
    displayName: Area
  file.name:
    displayName: Title
  agent:
    displayName: Agent
  formula.status_label:
    displayName: Status
  updated:
    displayName: Updated
views:
  - type: table
    name: Active
    filters:
      or:
        - status == "needs_attention"
        - status == "review"
        - status == "in_progress"
        - status == "queue"
    order:
      - formula.area
      - project
      - file.name
      - agent
      - formula.status_label
      - updated
    sort:
      - property: file.name
        direction: DESC
      - property: formula.status_label
        direction: ASC
      - property: updated
        direction: DESC
    columnSize:
      note.project: 156
      note.id: 83
  - type: table
    name: Attention
    filters:
      or:
        - status == "needs_attention"
        - and:
            - status == "review"
            - review_mode == "human"
    order:
      - formula.area
      - project
      - file.name
      - agent
      - formula.status_label
      - updated
    sort:
      - property: updated
        direction: DESC
  - type: table
    name: By project
    groupBy:
      property: project
      direction: ASC
    order:
      - file.name
      - agent
      - formula.status_label
      - updated
    sort:
      - property: formula.status_label
        direction: ASC
      - property: updated
        direction: DESC
  - type: table
    name: View all
    order:
      - formula.area
      - project
      - file.name
      - agent
      - formula.status_label
      - updated
    sort:
      - property: project
        direction: ASC
      - property: updated
        direction: ASC
      - property: formula.status_label
        direction: ASC
    columnSize:
      formula.status_label: 94
  - type: table
    name: Done
    filters:
      and:
        - status == "done"
    order:
      - formula.area
      - project
      - file.name
      - agent
      - formula.status_label
      - updated
    sort:
      - property: updated
        direction: DESC
