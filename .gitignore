# ─── OS / editor ───────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Root-level clutter ────────────────────────────────────────
/*.png

# ─── Obsidian ──────────────────────────────────────────────────
# Ignore everything inside .obsidian, then whitelist the three
# config files that define the shared vault experience.
.obsidian/*
!.obsidian/app.json
!.obsidian/community-plugins.json
!.obsidian/core-plugins.json

# ─── Python ────────────────────────────────────────────────────
__pycache__/
*.pyc

# ─── Playwright MCP cache ─────────────────────────────────────
.playwright-mcp/

# ─── Scratch / transient ──────────────────────────────────────
.scratch/

# ─── Claude Code internal ─────────────────────────────────────
# Track agents, HQ skills, and settings — ignore everything else
# that Claude Code may generate (hooks, caches, sessions, etc.).
.claude/*
!.claude/agents/
!.claude/skills/
!.claude/settings.local.json
.claude/agents/_private/

# Credentials and secrets never enter the tracked framework.
.agents/auth/

# ─── Private skills ───────────────────────────────────────────
# Skills used only by a private (_private/) agent stay local, the
# same way the agent does. The skill content lives in
# .agents/skills/_private/, and its symlink in .claude/skills/ is
# ignored per-name (that dir is otherwise whitelisted above).
# To add a private skill: drop it in .agents/skills/_private/,
# symlink it into .claude/skills/, and add the symlink name here.
.agents/skills/_private/
.claude/skills/dcf-valuation
.claude/skills/comps-valuation
.claude/skills/three-statement-model
.claude/skills/equity-initiating-coverage
.claude/skills/equity-screen
.claude/skills/equity-thesis-tracker
.claude/skills/portfolio-rebalance
.claude/skills/financial-plan

# ─── Per-person operator profile ──────────────────────────────
# The real IDENTITY.md is written by Pam on first run and stays
# local. Only IDENTITY.example.md (the template) is tracked.
IDENTITY.md

# ─── Per-person content ───────────────────────────────────────
# areas/ holds all per-person content (PRDs, notes, planning,
# codebases). It is git-ignored in its entirety; the empty dir
# survives a clone via the tracked .gitkeep.
areas/*
!areas/.gitkeep
